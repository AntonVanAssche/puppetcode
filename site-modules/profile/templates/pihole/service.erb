[Unit]
Description=Pi-hole
Wants=network.target
After=network-online.target

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=on-failure
TimeoutStopSec=70

ExecStartPre=/bin/rm -f %t/container-pihole.pid %t/container-pihole.ctr-id

ExecStart=/usr/bin/podman run \
  --conmon-pidfile %t/container-pihole.pid \
  --cidfile %t/container-pihole.ctr-id \
  --cgroups=no-conmon \
  --replace -d \
  --name pihole \
  --network host \
  --env PIHOLE_UID=<%= Etc.getpwnam(scope.lookupvar('profile::pihole::user')).uid %> \
  --env PIHOLE_GID=<%= Etc.getgrnam(scope.lookupvar('profile::pihole::group')).gid %> \
  --env VIRTUAL_HOST=<%= scope.lookupvar('facts')['networking']['fqdn'] %> \
  --env DNSMASQ_LISTENING=all \
  --env FTLCONF_webserver_api_password=<%= scope.lookupvar('profile::pihole::password') %> \
  --env FTLCONF_dns_upstreams="127.0.0.1#5053;9.9.9.9;149.112.112.112" \
  --env FTLCONF_dns_dnssec=true \
  --env FTLCONF_dns_listeningMode=all \
<% if scope.lookupvar('profile::pihole::a_records').any? -%>
  --env FTLCONF_dns_hosts="<%= scope.lookupvar('profile::pihole::a_records').map { |domain, ip| "#{ip} #{domain}" }.join(';') %>" \
<% end -%>
<% if scope.lookupvar('profile::pihole::cnames').any? -%>
  --env FTLCONF_dns_cnameRecords="<%= scope.lookupvar('profile::pihole::cnames').map { |alias_name, canonical| "#{alias_name}, #{canonical}" }.join(';') %>" \
<% end -%>
  --env TZ=Europe/Brussels \
  --volume=/var/lib/podman/volumes/configs/pihole:/etc/pihole:Z \
  --volume=/var/lib/podman/volumes/configs/dnsmasq.d:/etc/dnsmasq.d:Z \
  --publish=53:53/tcp \
  --publish=53:53/udp \
  --publish=80:80/tcp \
  docker.io/pihole/pihole

ExecStop=/usr/bin/podman stop --ignore --cidfile %t/container-pihole.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/container-pihole.ctr-id

PIDFile=%t/container-pihole.pid
Type=forking

[Install]
WantedBy=multi-user.target default.target
